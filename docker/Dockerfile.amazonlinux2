# OSNICK=amazonlinux2 — Amazon Linux 2 Redis build environment.
# README does not document AmazonLinux 2; the per-module install_script.sh
# (with its quirks/amazonlinux2.sh which adds devtoolset-11 + cmake3 +
# epel) covers everything Redis needs as well.
FROM amazonlinux:2

WORKDIR /workspace
ENV OSNICK=amazonlinux2

# install_script.sh requires bash, gawk, and tar; the base image ships
# them but not always git/curl. Pull the minimal bootstrap set first.
RUN yum -y install bash gawk tar git curl && \
    yum clean all

COPY modules.yaml /workspace/modules.yaml
COPY modules /workspace/modules
COPY modules/docker-install-bundled-module-deps.sh /workspace/modules/docker-install-bundled-module-deps.sh
RUN chmod +x /workspace/modules/docker-install-bundled-module-deps.sh && /workspace/modules/docker-install-bundled-module-deps.sh
