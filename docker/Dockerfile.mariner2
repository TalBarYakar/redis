# OSNICK=mariner2 — CBL-Mariner 2 Redis build environment.
# README does not document Mariner; install_script.sh handles every dep
# via the abstract->tdnf package map. The base image is minimal (no awk),
# so we install awk first; the install script also tdnf-install-bootstraps
# awk if missing, but doing it here keeps the layering deterministic.
FROM mcr.microsoft.com/cbl-mariner/base/core:2.0

WORKDIR /workspace
ENV OSNICK=mariner2

RUN tdnf -y install bash gawk tar git ca-certificates && \
    tdnf clean all

COPY modules.yaml /workspace/modules.yaml
COPY modules /workspace/modules
COPY modules/docker-install-bundled-module-deps.sh /workspace/modules/docker-install-bundled-module-deps.sh
RUN chmod +x /workspace/modules/docker-install-bundled-module-deps.sh && /workspace/modules/docker-install-bundled-module-deps.sh
