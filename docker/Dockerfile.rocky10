# OSNICK=rocky10 — Rocky Linux 10.x Redis build environment.
# Mirrors docker/Dockerfile.alma10 (same EL10 layout).
# Rocky 10 isn't published as `library/rockylinux` on Docker Hub yet, so
# we pull from the project's own quay.io registry like upstream RTS does.
FROM quay.io/rockylinux/rockylinux:10

WORKDIR /workspace
ENV OSNICK=rocky10

# Goreleaser repo + Development Tools.
RUN printf '%s\n' \
        '[goreleaser]' \
        'name=GoReleaser' \
        'baseurl=https://repo.goreleaser.com/yum/' \
        'enabled=1' \
        'gpgcheck=0' \
        > /etc/yum.repos.d/goreleaser.repo && \
    dnf clean all && \
    dnf makecache && \
    dnf -y update && \
    dnf -y groupinstall "Development Tools"

# Redis prereqs — system gcc on EL10 is current enough; no toolset.
RUN dnf -y install --nobest --skip-broken \
        pkg-config xz wget which \
        git make cmake openssl openssl-devel \
        python3 python3-pip python3-devel \
        unzip rsync clang curl libtool automake autoconf jq systemd-devel

# 3. Module deps via per-module install_script.sh (Phase 1 OSNICK env).
COPY modules.yaml /workspace/modules.yaml
COPY modules /workspace/modules
COPY modules/docker-install-bundled-module-deps.sh /workspace/modules/docker-install-bundled-module-deps.sh
RUN chmod +x /workspace/modules/docker-install-bundled-module-deps.sh && /workspace/modules/docker-install-bundled-module-deps.sh
