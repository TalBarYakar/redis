# OSNICK=alpine — Alpine 3.x Redis build environment.
# README does not document Alpine; we rely on the per-module
# install_script.sh + dependencies.yaml `apk:` package_map to provide
# every Redis build prereq (build-base, openssl-dev, make, cmake, etc.).
# We bootstrap only what install_script.sh itself needs to run.
FROM alpine:3

WORKDIR /workspace
ENV OSNICK=alpine

# install_script.sh has a bash shebang; alpine ships busybox sh by
# default. apk + awk are already provided by busybox.
RUN apk add --no-cache bash

# Module deps via per-module install_script.sh (Phase 1 OSNICK env). On
# alpine the script reads the abstract dep list from each module's
# dependencies.yaml and resolves it to apk packages. That same package
# list (build-base, openssl-dev, etc.) covers Redis's own prereqs.
COPY modules /workspace/modules
RUN failed=""; \
    for name in redistimeseries redisbloom redisjson redisearch; do \
        script="/workspace/modules/$name/src/.install/install_script.sh"; \
        if [ -x "$script" ]; then \
            echo "==> [$name] install_script.sh (OSNICK=$OSNICK)"; \
            if ! (cd "/workspace/modules/$name/src/.install" && bash install_script.sh); then \
                echo "==> [$name] WARNING: install_script.sh failed (continuing)"; \
                failed="$failed $name"; \
            fi; \
        else \
            echo "==> [$name] not cloned, skipping"; \
        fi; \
    done; \
    if [ -n "$failed" ]; then \
        echo "==> WARNING: module installer(s) failed:$failed"; \
        echo "==> Image still tagged; affected modules will need their deps installed at runtime."; \
    else \
        echo "==> All available module installers completed."; \
    fi
