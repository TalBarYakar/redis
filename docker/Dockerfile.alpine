# OSNICK=alpine — Alpine 3.x Redis build environment.
# README does not document Alpine; we rely on the per-module
# install_script.sh + dependencies.yaml `apk:` package_map to provide
# every Redis build prereq (build-base, openssl-dev, make, cmake, etc.).
# We bootstrap only what install_script.sh itself needs to run.
FROM alpine:3.21

WORKDIR /workspace
ENV OSNICK=alpine

# install_script.sh expects bash; gawk matches install_script's awk bootstrap
# (BusyBox awk is not sufficient for dependencies.yaml parsing).
RUN apk add --no-cache bash gawk

# Module deps via per-module install_script.sh (Phase 1 OSNICK env). On
# alpine the script reads the abstract dep list from each module's
# dependencies.yaml and resolves it to apk packages. That same package
# list (build-base, openssl-dev, etc.) covers Redis's own prereqs.
COPY modules.yaml /workspace/modules.yaml
COPY modules /workspace/modules
COPY modules/docker-install-bundled-module-deps.sh /workspace/modules/docker-install-bundled-module-deps.sh
RUN chmod +x /workspace/modules/docker-install-bundled-module-deps.sh && /workspace/modules/docker-install-bundled-module-deps.sh
