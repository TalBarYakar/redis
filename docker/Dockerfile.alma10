# OSNICK=alma10 — AlmaLinux 10.x Redis build environment.
# Extrapolated from docker/Dockerfile.alma9 — README only covers 8.10/9.5,
# but the install steps carry forward unchanged on the EL10 family. We
# don't need the manual cmake step (EL10 ships a sufficiently recent
# cmake) and `gcc-toolset-13` is no longer the obvious choice (EL10's
# system gcc is already 14.x), so we lean on the system toolchain.
FROM almalinux:10

WORKDIR /workspace
ENV OSNICK=alma10

# 1. Goreleaser repo + Development Tools.
RUN printf '%s\n' \
        '[goreleaser]' \
        'name=GoReleaser' \
        'baseurl=https://repo.goreleaser.com/yum/' \
        'enabled=1' \
        'gpgcheck=0' \
        > /etc/yum.repos.d/goreleaser.repo && \
    dnf clean all && \
    dnf makecache && \
    dnf -y update && \
    dnf -y groupinstall "Development Tools"

# 2. Redis prereqs — system gcc on EL10 is current enough; no toolset.
RUN dnf -y install --nobest --skip-broken \
        pkg-config xz wget which \
        git make cmake openssl openssl-devel \
        python3 python3-pip python3-devel \
        unzip rsync clang curl libtool automake autoconf jq systemd-devel && \
    python3 -m venv /opt/venv

# 3. Module deps via per-module install_script.sh (Phase 1 OSNICK env).
COPY modules /workspace/modules
RUN failed=""; \
    for name in redistimeseries redisbloom redisjson redisearch; do \
        script="/workspace/modules/$name/src/.install/install_script.sh"; \
        if [ -x "$script" ]; then \
            echo "==> [$name] install_script.sh (OSNICK=$OSNICK)"; \
            if ! (cd "/workspace/modules/$name/src/.install" && bash install_script.sh); then \
                echo "==> [$name] WARNING: install_script.sh failed (continuing)"; \
                failed="$failed $name"; \
            fi; \
        else \
            echo "==> [$name] not cloned, skipping"; \
        fi; \
    done; \
    if [ -n "$failed" ]; then \
        echo "==> WARNING: module installer(s) failed:$failed"; \
        echo "==> Image still tagged; affected modules will need their deps installed at runtime."; \
    else \
        echo "==> All available module installers completed."; \
    fi
