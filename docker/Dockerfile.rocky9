# OSNICK=rocky9 — Rocky Linux 9.x Redis build environment.
# Mirrors docker/Dockerfile.alma9 (same dnf layout, same README section).
FROM rockylinux:9

WORKDIR /workspace
ENV OSNICK=rocky9

# Repos + Development Tools (printf used so legacy Docker engines without
# BuildKit heredoc support still parse this RUN cleanly).
RUN printf '%s\n' \
        '[goreleaser]' \
        'name=GoReleaser' \
        'baseurl=https://repo.goreleaser.com/yum/' \
        'enabled=1' \
        'gpgcheck=0' \
        > /etc/yum.repos.d/goreleaser.repo && \
    dnf clean all && \
    dnf makecache && \
    dnf -y update && \
    dnf -y groupinstall "Development Tools"

# Redis prereqs + venv + toolset enable.
RUN dnf -y install --nobest --skip-broken \
        pkg-config xz wget which \
        gcc-toolset-13-gcc gcc-toolset-13-gcc-c++ \
        git make openssl openssl-devel \
        python3 python3-pip python3-devel \
        unzip rsync clang curl libtool automake autoconf jq systemd-devel && \
    python3 -m venv /opt/venv && \
    cp /opt/rh/gcc-toolset-13/enable /etc/profile.d/gcc-toolset-13.sh && \
    echo "source /etc/profile.d/gcc-toolset-13.sh" >> /etc/bashrc

ENV PATH="/opt/rh/gcc-toolset-13/root/usr/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/rh/gcc-toolset-13/root/usr/lib64"

# CMake 3.25.1 manual install.
RUN CMAKE_VERSION=3.25.1 && \
    ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then CMAKE_FILE=cmake-${CMAKE_VERSION}-linux-x86_64.sh; \
    else CMAKE_FILE=cmake-${CMAKE_VERSION}-linux-aarch64.sh; fi && \
    wget -q https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/${CMAKE_FILE} && \
    chmod +x ${CMAKE_FILE} && \
    ./${CMAKE_FILE} --skip-license --prefix=/usr/local --exclude-subdir && \
    rm ${CMAKE_FILE} && \
    cmake --version

# Module deps via per-module install_script.sh (Phase 1 OSNICK env).
COPY modules /workspace/modules
RUN failed=""; \
    for name in redistimeseries redisbloom redisjson redisearch; do \
        script="/workspace/modules/$name/src/.install/install_script.sh"; \
        if [ -x "$script" ]; then \
            echo "==> [$name] install_script.sh (OSNICK=$OSNICK)"; \
            if ! (cd "/workspace/modules/$name/src/.install" && bash install_script.sh); then \
                echo "==> [$name] WARNING: install_script.sh failed (continuing)"; \
                failed="$failed $name"; \
            fi; \
        else \
            echo "==> [$name] not cloned, skipping"; \
        fi; \
    done; \
    if [ -n "$failed" ]; then \
        echo "==> WARNING: module installer(s) failed:$failed"; \
        echo "==> Image still tagged; affected modules will need their deps installed at runtime."; \
    else \
        echo "==> All available module installers completed."; \
    fi
