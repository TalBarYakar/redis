# OSNICK=alma9 — AlmaLinux 9.x Redis build environment.
# See docker/Dockerfile.focal header for the shared layout rationale.
#
# Follows README §"Build and run Redis with all data structures -
# AlmaLinux 9.5 / Rocky Linux 9.5". On EL9 we don't need powertools/EPEL
# for Redis itself, but redisjson's install_script.sh enables CRB later
# for libev/libevent dev headers (see modules/redisjson/.install).
FROM almalinux:9

WORKDIR /workspace
ENV OSNICK=alma9

# 1. Repos + Development Tools (printf used so legacy Docker engines
#    without BuildKit heredoc support still parse this RUN cleanly).
RUN printf '%s\n' \
        '[goreleaser]' \
        'name=GoReleaser' \
        'baseurl=https://repo.goreleaser.com/yum/' \
        'enabled=1' \
        'gpgcheck=0' \
        > /etc/yum.repos.d/goreleaser.repo && \
    dnf clean all && \
    dnf makecache && \
    dnf -y update && \
    dnf -y groupinstall "Development Tools"

# 2. Redis prereqs — README's dnf install line + venv + toolset enable.
RUN dnf -y install --nobest --skip-broken \
        pkg-config xz wget which \
        gcc-toolset-13-gcc gcc-toolset-13-gcc-c++ \
        git make openssl openssl-devel \
        python3 python3-pip python3-devel \
        unzip rsync clang curl libtool automake autoconf jq systemd-devel && \
    cp /opt/rh/gcc-toolset-13/enable /etc/profile.d/gcc-toolset-13.sh && \
    echo "source /etc/profile.d/gcc-toolset-13.sh" >> /etc/bashrc

ENV PATH="/opt/rh/gcc-toolset-13/root/usr/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/rh/gcc-toolset-13/root/usr/lib64"

# 3. CMake 3.25.1 manual install — packaged dnf cmake on EL9 is also a bit
#    behind what some module builds expect, README installs it manually too.
RUN CMAKE_VERSION=3.25.1 && \
    ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then CMAKE_FILE=cmake-${CMAKE_VERSION}-linux-x86_64.sh; \
    else CMAKE_FILE=cmake-${CMAKE_VERSION}-linux-aarch64.sh; fi && \
    wget -q https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/${CMAKE_FILE} && \
    chmod +x ${CMAKE_FILE} && \
    ./${CMAKE_FILE} --skip-license --prefix=/usr/local --exclude-subdir && \
    rm ${CMAKE_FILE} && \
    cmake --version

# 4. Module deps via per-module install_script.sh (Phase 1 OSNICK env).
COPY modules.yaml /workspace/modules.yaml
COPY modules /workspace/modules
COPY modules/docker-install-bundled-module-deps.sh /workspace/modules/docker-install-bundled-module-deps.sh
RUN chmod +x /workspace/modules/docker-install-bundled-module-deps.sh && /workspace/modules/docker-install-bundled-module-deps.sh
