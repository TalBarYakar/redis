# OSNICK=noble — Ubuntu 24.04 Redis build environment.
# See docker/Dockerfile.focal header for the shared layout rationale.
FROM ubuntu:24.04

WORKDIR /workspace
ENV OSNICK=noble
ENV DEBIAN_FRONTEND=noninteractive

RUN printf 'Acquire::Retries "3";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' \
    > /etc/apt/apt.conf.d/80-retries

# 1. Redis prereqs — README §Ubuntu 24.04 (Noble).
#    Apt's cmake on noble is recent enough; no pip cmake step required.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates wget dpkg-dev gcc g++ libc6-dev libssl-dev make git cmake \
        python3 python3-pip python3-venv python3-dev \
        unzip rsync clang automake autoconf libtool pkg-config python-is-python3 && \
    rm -rf /var/lib/apt/lists/*

# 2. Module deps via per-module install_script.sh (Phase 1 OSNICK env).
COPY modules /workspace/modules
RUN failed=""; \
    for name in redistimeseries redisbloom redisjson redisearch; do \
        script="/workspace/modules/$name/src/.install/install_script.sh"; \
        if [ -x "$script" ]; then \
            echo "==> [$name] install_script.sh (OSNICK=$OSNICK)"; \
            if ! (cd "/workspace/modules/$name/src/.install" && bash install_script.sh); then \
                echo "==> [$name] WARNING: install_script.sh failed (continuing)"; \
                failed="$failed $name"; \
            fi; \
        else \
            echo "==> [$name] not cloned, skipping"; \
        fi; \
    done; \
    if [ -n "$failed" ]; then \
        echo "==> WARNING: module installer(s) failed:$failed"; \
        echo "==> Image still tagged; affected modules will need their deps installed at runtime."; \
    else \
        echo "==> All available module installers completed."; \
    fi
